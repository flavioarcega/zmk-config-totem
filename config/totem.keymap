#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define LNUM  1
#define RNUM  2
#define MOUSE 3
#define FKEYS 4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
};

&msc {
    x-input-code = <INPUT_REL_HWHEEL>;
    y-input-code = <INPUT_REL_WHEEL>;
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <0>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            //                     ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓   ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
            //                     ┃      Q      ┃      W      ┃      E      ┃      R      ┃      T      ┃   ┃      Y      ┃      U      ┃      I      ┃      O      ┃      P      ┃
            //                     ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫
            //                     ┃      A      ┃      S      ┃      D      ┃      F      ┃      G      ┃   ┃      H      ┃      J      ┃      K      ┃      L      ┃      :      ┃
            //       ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓
            //       ┃     ESC     ┃      Z      ┃      X      ┃      C      ┃      V      ┃      B      ┃   ┃      N      ┃      M      ┃      ,      ┃      .      ┃      /      ┃     TAB     ┃
            //       ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            //                                                 ┃    LALT     ┃     DEL     ┃    BSPC     ┃   ┃    SPACE    ┃    ENTER    ┃    BSPC     ┃
            //                                                 ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛

            bindings = <
         &kp Q        &kp W        &kp E        &kp R    &kp T       &kp Y      &kp U      &kp I        &kp O        &kp P
         &mt LSHFT A  &mt LCTRL S  &lt MOUSE D  &lt 1 F  &kp G       &kp H      &lt 2 J    &lt FKEYS K  &mt LCTRL L  &mt RSHIFT COLON
&kp ESC  &kp Z        &kp X        &kp C        &kp V    &kp B       &kp N      &kp M      &kp COMMA    &kp DOT      &kp FSLH          &mt PSCRN TAB
                                   &kp LALT     &kp DEL  &kp BSPC    &kp SPACE  &kp ENTER  &kp RALT
            >;
        };

        //        bindings = <
        //            &kp Q  &kp W  &kp E     &kp R  &kp T    &kp Y      &kp U            &kp I          &kp O    &kp P
        //            &kp A  &kp S  &kp D     &kp F  &kp G    &kp H      &kp J            &kp K          &kp L    &kp SEMI
        //  &kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B    &kp N      &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp APOS
        //                          &kp LGUI  &mo 2  &mo 1    &kp SPACE  &kp RIGHT_SHIFT  &kp RIGHT_ALT
        //        >;

        lnum_layer {
            label = "LNUM";

            //                     ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓   ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
            //                     ┃      1      ┃      2      ┃      3      ┃      4      ┃      5      ┃   ┃      6      ┃      7      ┃      8      ┃      9      ┃      0      ┃
            //                     ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫
            //                     ┃      +      ┃      -      ┃      *      ┃      /      ┃      =      ┃   ┃    RIGHT    ┃    DOWN     ┃      UP     ┃     LEFT    ┃             ┃
            //       ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓
            //       ┃             ┃      [      ┃             ┃             ┃      \      ┃             ┃   ┃    HOME     ┃    PG_DN    ┃    PG_UP    ┃     END     ┃      ]      ┃             ┃
            //       ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            //                                                 ┃    LALT     ┃     DEL     ┃    BSPC     ┃   ┃    SPACE    ┃    ENTER    ┃     RALT    ┃
            //                                                 ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛

            bindings = <
        &kp N1     &kp N2     &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
        &kp LSHFT  &kp LCTRL  &none   &trans  &none     &kp RIGHT  &kp DOWN   &kp UP     &kp LEFT  &none
&trans  &none      &none      &none   &none   &none     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &kp RBKT  &trans
                              &trans  &trans  &trans    &trans     &trans     &trans
            >;
        };

        //        bindings = <
        //                     &kp LA(BACKSPACE)   &kp BACKSPACE  &kp UP     &kp DELETE     &kp LA(DELETE)        &kp N5      &kp N6           &kp N7       &kp N8    &kp N9
        //                     &kp LA(LEFT_ARROW)  &kp LEFT       &kp DOWN   &kp RIGHT      &kp LA(RIGHT)         &kp N0      &kp N1           &kp N2       &kp N3    &kp N4
        //  &kp LG(BACKSPACE)  &kp LG(UP_ARROW)    &kp LG(LEFT)   &kp ENTER  &kp LG(RIGHT)  &kp LG(DOWN_ARROW)    &kp PERIOD  &kp PLUS         &kp MINUS    &kp STAR  &kp FSLH  &kp CARET
        //                                                        &trans     &trans         &trans                &kp EQUAL   &kp RIGHT_SHIFT  &kp PERCENT
        //        >;

        rnum_layer {
            label = "RNUM";

            //                     ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓   ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
            //                     ┃      1      ┃      2      ┃      3      ┃      4      ┃      5      ┃   ┃      6      ┃      7      ┃      8      ┃      9      ┃      0      ┃
            //                     ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫
            //                     ┃      +      ┃      -      ┃      *      ┃      /      ┃      =      ┃   ┃    RIGHT    ┃    DOWN     ┃      UP     ┃     LEFT    ┃             ┃
            //       ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓
            //       ┃             ┃      [      ┃             ┃             ┃      \      ┃             ┃   ┃    HOME     ┃    PG_DN    ┃    PG_UP    ┃     END     ┃      ]      ┃             ┃
            //       ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            //                                                 ┃    LALT     ┃     DEL     ┃    BSPC     ┃   ┃    SPACE    ┃    ENTER    ┃     RALT    ┃
            //                                                 ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛

            bindings = <
        &kp N1    &kp N2     &kp N3    &kp N4    &kp N5       &kp N6  &kp N7  &kp N8  &kp N9     &kp N0
        &kp PLUS  &kp MINUS  &kp STAR  &kp FSLH  &kp EQUAL    &none   &trans  &none   &kp LCTRL  &kp RSHIFT
&trans  &kp LBKT  &none      &none     &kp BSLH  &none        &none   &none   &none   &none      &none       &trans
                             &trans    &trans    &trans       &trans  &trans  &trans
            >;
        };

        //        bindings = <
        //             &kp ESC        &kp LEFT_BRACE        &kp RIGHT_BRACE        &none             &none             &kp F1   &kp F2           &kp F3   &kp F4   &kp F5
        //             &kp TAB        &kp LBKT              &kp RBKT               &kp ENTER         &kp BSLH          &kp F6   &kp F7           &kp F8   &kp F9   &kp F10
        //  &kp GRAVE  &kp LESS_THAN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &kp UNDERSCORE    &kp F11  &kp F12          &kp F13  &kp F14  &kp F15  &kp F16
        //                                                  &trans                 &trans            &trans            &none    &kp RIGHT_SHIFT  &none
        //        >;

        mouse_layer {
            label = "MOUSE";

            //                     ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓   ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
            //                     ┃             ┃             ┃             ┃             ┃             ┃   ┃             ┃             ┃             ┃             ┃             ┃
            //                     ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫
            //                     ┃             ┃             ┃             ┃             ┃             ┃   ┃  MOVE_LEFT  ┃  MOVE_DOWN  ┃   MOVE_UP   ┃  MOVE_RIGHT ┃             ┃
            //       ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓
            //       ┃             ┃             ┃             ┃             ┃             ┃             ┃   ┃  SCRL_LEFT  ┃  SCRL_DOWN  ┃   SCRL_UP   ┃  SCRL_RIGHT ┃             ┃   BT_NXT    ┃
            //       ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            //                                                 ┃             ┃             ┃    LCLK     ┃   ┃    RCLK     ┃    MCLK     ┃             ┃
            //                                                 ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛

            bindings = <
                                    &none         &none         &none         &none         &none             &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(UP)   &kp LG(RIGHT)   &none
                                    &none         &none         &none         &none         &none             &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none
                      &none         &none         &none         &none         &none         &none             &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none      &bt BT_NXT
                                                                &none         &none         &mkp RCLK         &mkp LCLK      &mkp MCLK      &none
            >;
        };

        //        bindings = <
        //         &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
        //         &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
        //  &none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
        //                                           &none                 &none             &none    &none         &none         &none
        //        >;

        fkeys_layer {
            label = "FKEYS";

            //                     ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓   ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
            //                     ┃     F1      ┃     F2      ┃     F3      ┃     F4      ┃             ┃   ┃             ┃             ┃             ┃             ┃             ┃
            //                     ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫
            //                     ┃     F5      ┃     F6      ┃     F7      ┃     F8      ┃             ┃   ┃             ┃             ┃             ┃             ┃             ┃
            //       ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓
            //       ┃   BT_PREV   ┃     F9      ┃     F10     ┃     F11     ┃     F12     ┃             ┃   ┃             ┃             ┃             ┃             ┃             ┃             ┃
            //       ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            //                                                 ┃             ┃   BT_CLR    ┃             ┃   ┃             ┃             ┃             ┃
            //                                                 ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛

            bindings = <
                                    &kp F1        &kp F2        &kp F3        &kp F4      &none              &none             &none  &none  &none  &none
                                    &kp F5        &kp F6        &kp F7        &kp F8      &none              &none             &none  &none  &none  &none
                      &bt BT_PRV    &kp F9        &kp F10       &kp F11       &kp F12     &none              &none             &none  &none  &none  &none  &none
                                                                &none         &bt BT_CLR  &kp LG(PAGE_UP)    &kp LG(PAGE_DOWN)  &none  &none
            >;
        };
    };
};
